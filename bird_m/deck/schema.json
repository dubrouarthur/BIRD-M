{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://birdmodels.ai/schemas/bird-deck-0.1.json",
  "title": "BIRD-Deck v0.1",
  "description": "Semantic slide deck produced by BIRD-M. Content and layout choice only; visual design belongs to the renderer/editor. x-maxWords limits keep every slide readable.",
  "type": "object",
  "required": ["version", "meta", "slides"],
  "additionalProperties": false,
  "properties": {
    "version": { "const": "bird-deck/0.1" },
    "meta": {
      "type": "object",
      "required": ["title", "lang"],
      "additionalProperties": false,
      "properties": {
        "title": { "type": "string", "minLength": 1, "x-maxWords": 12 },
        "lang": { "enum": ["fr", "en"] },
        "author": { "type": "string", "x-maxWords": 8 },
        "date": { "type": "string", "x-maxWords": 4 }
      }
    },
    "theme": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "preset": { "enum": ["bird", "ardoise", "foret", "corail"] },
        "primary": { "$ref": "#/$defs/color" },
        "accent": { "$ref": "#/$defs/color" },
        "brand": { "type": "string", "x-maxWords": 4 }
      }
    },
    "slides": {
      "type": "array",
      "minItems": 1,
      "maxItems": 40,
      "items": { "$ref": "#/$defs/slide" }
    }
  },
  "$defs": {
    "color": { "type": "string", "pattern": "^#[0-9a-fA-F]{6}$" },
    "title": { "type": "string", "minLength": 1, "x-maxWords": 14 },
    "kicker": { "type": "string", "x-maxWords": 4 },
    "notes": { "type": "string", "x-maxWords": 150 },
    "bullet": { "type": "string", "minLength": 1, "x-maxWords": 16 },
    "trend": { "enum": ["up", "down", "flat"] },
    "slide": {
      "type": "object",
      "required": ["layout"],
      "properties": {
        "layout": {
          "enum": ["title", "section", "agenda", "bullets", "two_columns", "big_number", "kpis", "chart", "comparison", "timeline", "quote", "table", "closing"]
        }
      }
    },
    "layout_title": {
      "type": "object", "additionalProperties": false, "required": ["layout", "title"],
      "properties": {
        "layout": { "const": "title" }, "title": { "$ref": "#/$defs/title" },
        "subtitle": { "type": "string", "x-maxWords": 20 }, "kicker": { "$ref": "#/$defs/kicker" }, "notes": { "$ref": "#/$defs/notes" }
      }
    },
    "layout_section": {
      "type": "object", "additionalProperties": false, "required": ["layout", "title"],
      "properties": {
        "layout": { "const": "section" }, "title": { "type": "string", "minLength": 1, "x-maxWords": 8 },
        "number": { "type": "integer", "minimum": 1, "maximum": 20 }, "subtitle": { "type": "string", "x-maxWords": 16 }, "notes": { "$ref": "#/$defs/notes" }
      }
    },
    "layout_agenda": {
      "type": "object", "additionalProperties": false, "required": ["layout", "title", "items"],
      "properties": {
        "layout": { "const": "agenda" }, "title": { "$ref": "#/$defs/title" },
        "items": { "type": "array", "minItems": 2, "maxItems": 7, "items": { "type": "string", "minLength": 1, "x-maxWords": 8 } },
        "notes": { "$ref": "#/$defs/notes" }
      }
    },
    "layout_bullets": {
      "type": "object", "additionalProperties": false, "required": ["layout", "title", "bullets"],
      "properties": {
        "layout": { "const": "bullets" }, "title": { "$ref": "#/$defs/title" }, "kicker": { "$ref": "#/$defs/kicker" },
        "bullets": { "type": "array", "minItems": 2, "maxItems": 6, "items": { "$ref": "#/$defs/bullet" } },
        "notes": { "$ref": "#/$defs/notes" }
      }
    },
    "layout_two_columns": {
      "type": "object", "additionalProperties": false, "required": ["layout", "title", "left", "right"],
      "properties": {
        "layout": { "const": "two_columns" }, "title": { "$ref": "#/$defs/title" }, "kicker": { "$ref": "#/$defs/kicker" },
        "left": { "$ref": "#/$defs/column" }, "right": { "$ref": "#/$defs/column" }, "notes": { "$ref": "#/$defs/notes" }
      }
    },
    "column": {
      "type": "object", "additionalProperties": false, "required": ["heading", "bullets"],
      "properties": {
        "heading": { "type": "string", "minLength": 1, "x-maxWords": 5 },
        "bullets": { "type": "array", "minItems": 1, "maxItems": 5, "items": { "type": "string", "minLength": 1, "x-maxWords": 12 } }
      }
    },
    "layout_big_number": {
      "type": "object", "additionalProperties": false, "required": ["layout", "title", "value", "label"],
      "properties": {
        "layout": { "const": "big_number" }, "title": { "$ref": "#/$defs/title" }, "kicker": { "$ref": "#/$defs/kicker" },
        "value": { "type": "string", "minLength": 1, "maxLength": 9 }, "label": { "type": "string", "minLength": 1, "x-maxWords": 10 },
        "context": { "type": "string", "x-maxWords": 28 }, "trend": { "$ref": "#/$defs/trend" }, "notes": { "$ref": "#/$defs/notes" }
      }
    },
    "layout_kpis": {
      "type": "object", "additionalProperties": false, "required": ["layout", "title", "kpis"],
      "properties": {
        "layout": { "const": "kpis" }, "title": { "$ref": "#/$defs/title" }, "kicker": { "$ref": "#/$defs/kicker" },
        "kpis": {
          "type": "array", "minItems": 2, "maxItems": 4,
          "items": {
            "type": "object", "additionalProperties": false, "required": ["value", "label"],
            "properties": {
              "value": { "type": "string", "minLength": 1, "maxLength": 8 }, "label": { "type": "string", "minLength": 1, "x-maxWords": 6 },
              "delta": { "type": "string", "maxLength": 10 }, "trend": { "$ref": "#/$defs/trend" }
            }
          }
        },
        "notes": { "$ref": "#/$defs/notes" }
      }
    },
    "layout_chart": {
      "type": "object", "additionalProperties": false, "required": ["layout", "title", "chart", "takeaway"],
      "properties": {
        "layout": { "const": "chart" }, "title": { "$ref": "#/$defs/title" }, "kicker": { "$ref": "#/$defs/kicker" },
        "chart": {
          "type": "object", "additionalProperties": false, "required": ["type", "categories", "series"],
          "properties": {
            "type": { "enum": ["bar", "line", "donut", "stacked_bar"] },
            "categories": { "type": "array", "minItems": 2, "maxItems": 12, "items": { "type": "string", "minLength": 1, "maxLength": 14 } },
            "series": {
              "type": "array", "minItems": 1, "maxItems": 4,
              "items": {
                "type": "object", "additionalProperties": false, "required": ["name", "values"],
                "properties": { "name": { "type": "string", "minLength": 1, "x-maxWords": 4 }, "values": { "type": "array", "items": { "type": "number" } } }
              }
            },
            "unit": { "type": "string", "maxLength": 6 },
            "highlight": { "type": "integer", "minimum": 0 }
          }
        },
        "takeaway": { "type": "string", "minLength": 1, "x-maxWords": 22 }, "source": { "type": "string", "x-maxWords": 10 },
        "notes": { "$ref": "#/$defs/notes" }
      }
    },
    "layout_comparison": {
      "type": "object", "additionalProperties": false, "required": ["layout", "title", "options"],
      "properties": {
        "layout": { "const": "comparison" }, "title": { "$ref": "#/$defs/title" }, "kicker": { "$ref": "#/$defs/kicker" },
        "options": {
          "type": "array", "minItems": 2, "maxItems": 3,
          "items": {
            "type": "object", "additionalProperties": false, "required": ["heading", "points"],
            "properties": {
              "heading": { "type": "string", "minLength": 1, "x-maxWords": 4 },
              "points": { "type": "array", "minItems": 1, "maxItems": 4, "items": { "type": "string", "minLength": 1, "x-maxWords": 10 } },
              "recommended": { "type": "boolean" }
            }
          }
        },
        "verdict": { "type": "string", "x-maxWords": 18 }, "notes": { "$ref": "#/$defs/notes" }
      }
    },
    "layout_timeline": {
      "type": "object", "additionalProperties": false, "required": ["layout", "title", "steps"],
      "properties": {
        "layout": { "const": "timeline" }, "title": { "$ref": "#/$defs/title" }, "kicker": { "$ref": "#/$defs/kicker" },
        "steps": {
          "type": "array", "minItems": 3, "maxItems": 6,
          "items": {
            "type": "object", "additionalProperties": false, "required": ["date", "label"],
            "properties": {
              "date": { "type": "string", "minLength": 1, "maxLength": 12 }, "label": { "type": "string", "minLength": 1, "x-maxWords": 6 },
              "detail": { "type": "string", "x-maxWords": 14 }, "done": { "type": "boolean" }
            }
          }
        },
        "notes": { "$ref": "#/$defs/notes" }
      }
    },
    "layout_quote": {
      "type": "object", "additionalProperties": false, "required": ["layout", "quote", "author"],
      "properties": {
        "layout": { "const": "quote" }, "quote": { "type": "string", "minLength": 1, "x-maxWords": 35 },
        "author": { "type": "string", "minLength": 1, "x-maxWords": 5 }, "role": { "type": "string", "x-maxWords": 8 }, "notes": { "$ref": "#/$defs/notes" }
      }
    },
    "layout_table": {
      "type": "object", "additionalProperties": false, "required": ["layout", "title", "header", "rows"],
      "properties": {
        "layout": { "const": "table" }, "title": { "$ref": "#/$defs/title" }, "kicker": { "$ref": "#/$defs/kicker" },
        "header": { "type": "array", "minItems": 2, "maxItems": 5, "items": { "type": "string", "minLength": 1, "x-maxWords": 3 } },
        "rows": {
          "type": "array", "minItems": 1, "maxItems": 7,
          "items": { "type": "array", "minItems": 2, "maxItems": 5, "items": { "type": "string", "x-maxWords": 6 } }
        },
        "highlight_row": { "type": "integer", "minimum": 0 }, "notes": { "$ref": "#/$defs/notes" }
      }
    },
    "layout_closing": {
      "type": "object", "additionalProperties": false, "required": ["layout", "title"],
      "properties": {
        "layout": { "const": "closing" }, "title": { "$ref": "#/$defs/title" },
        "bullets": { "type": "array", "maxItems": 3, "items": { "type": "string", "minLength": 1, "x-maxWords": 14 } },
        "cta": { "type": "string", "x-maxWords": 12 }, "contact": { "type": "string", "x-maxWords": 8 }, "notes": { "$ref": "#/$defs/notes" }
      }
    }
  }
}
